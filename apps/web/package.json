{
  "name": "@sereno/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vue-tsc --noEmit && vite build",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "contracts": "openapi-typescript ../api/openapi.json -o src/lib/api/types.generated.ts",
    "format:check": "prettier --check src",
    "lint": "prettier --check src && vue-tsc --noEmit",
    "format": "prettier --write src"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.1.0",
    "@tanstack/vue-query": "^5.90.0",
    "chart.js": "^4.5.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-vue-next": "^0.468.0",
    "pinia": "^4.1.0",
    "reka-ui": "^2.11.0",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.1.0",
    "vue": "^3.5.44",
    "vue-chartjs": "^5.3.0",
    "vue-router": "^4.6.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@vitejs/plugin-vue": "^6.0.0",
    "@vue/test-utils": "^2.4.0",
    "jsdom": "^26.1.0",
    "openapi-typescript": "^7.10.1",
    "typescript": "~5.9.0",
    "vite": "^7.3.0",
    "vitest": "^5.0.5",
    "vue-tsc": "^3.1.0"
  }
}
